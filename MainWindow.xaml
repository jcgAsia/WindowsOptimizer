<Window
    x:Class="WindowsOptimizer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:WindowsOptimizer.ViewModels"
    Title="Windows Optimizer - PlanB v1.4"
    Width="950"
    Height="950"
    Background="#1E1E1E"
    Closing="Window_Closing"
    WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <SolidColorBrush x:Key="BackgroundDark" Color="#1E1E1E" />
        <SolidColorBrush x:Key="BackgroundMedium" Color="#252526" />
        <SolidColorBrush x:Key="BackgroundLight" Color="#333333" />
        <SolidColorBrush x:Key="BorderColor" Color="#3F3F46" />
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextSecondary" Color="#AAAAAA" />
        <SolidColorBrush x:Key="AccentGreen" Color="#4EC9B0" />
        <SolidColorBrush x:Key="AccentBlue" Color="#569CD6" />
        <SolidColorBrush x:Key="AccentOrange" Color="#CE9178" />
        <SolidColorBrush x:Key="AccentYellow" Color="#DCDCAA" />

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border
                                Grid.Row="0"
                                Padding="12,8"
                                Background="#2D2D30"
                                CornerRadius="6,6,0,0">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#569CD6"
                                    Text="{TemplateBinding Header}" />
                            </Border>
                            <Border
                                Grid.Row="1"
                                Padding="{TemplateBinding Padding}"
                                Background="#252526"
                                BorderBrush="#3F3F46"
                                BorderThickness="1,0,1,1"
                                CornerRadius="0,0,6,6">
                                <ContentPresenter />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BackgroundLight}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#505050" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="AccentButton"
            BasedOn="{StaticResource {x:Type Button}}"
            TargetType="Button">
            <Setter Property="Background" Value="#0E639C" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderThickness="0"
                            CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1177BB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <!--  TabControl / TabItem 다크 테마 스타일  -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource BackgroundDark}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="{StaticResource BackgroundLight}" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border
                            x:Name="TabBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="1,1,1,0"
                            CornerRadius="6,6,0,0">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                ContentSource="Header"
                                TextBlock.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource BackgroundMedium}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBlue}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#3A3A3C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <!--  Tab 1: 모니터링  -->
            <TabItem Header="모니터링">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

        <!--  모니터링 상태  -->
        <GroupBox Grid.Row="0" Header="📊 모니터링 상태">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,15,8"
                        Foreground="{StaticResource TextSecondary}">
                        상태:
                    </TextBlock>
                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="0,0,0,8"
                        Orientation="Horizontal">
                        <Ellipse
                            Width="12"
                            Height="12"
                            Margin="0,0,8,0"
                            Fill="{Binding StatusColor}" />
                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimary}"
                            Text="{Binding StatusText}" />
                    </StackPanel>

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,0,15,8"
                        Foreground="{StaticResource TextSecondary}">
                        현재 URL:
                    </TextBlock>
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,0,0,8"
                        Foreground="{StaticResource AccentGreen}"
                        Text="{Binding CurrentUrl}"
                        TextTrimming="CharacterEllipsis" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="0,0,15,0"
                        Foreground="{StaticResource TextSecondary}">
                        트리거:
                    </TextBlock>
                    <StackPanel
                        Grid.Row="2"
                        Grid.Column="1"
                        Orientation="Horizontal">
                        <TextBlock Foreground="{StaticResource AccentOrange}" Text="{Binding TriggerInfo}" />
                        <TextBlock
                            Margin="20,0,0,0"
                            Foreground="{StaticResource AccentBlue}"
                            Text="{Binding LastKeyword}" />
                    </StackPanel>
                </Grid>

                <StackPanel
                    Grid.Column="1"
                    Margin="20,0,0,0"
                    VerticalAlignment="Center">
                    <Button
                        Width="130"
                        Height="40"
                        Margin="0,0,0,8"
                        Command="{Binding ToggleMonitoringCommand}"
                        Content="{Binding MonitorButtonText}"
                        FontWeight="Bold"
                        Style="{StaticResource AccentButton}" />
                    <Button
                        Width="130"
                        Command="{Binding ReloadConfigCommand}"
                        Content="🔄 설정 새로고침" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <!--  서버 설정 상태  -->
        <GroupBox Grid.Row="1" Header="{Binding MappingFileName, StringFormat='⚙️ 서버 설정 상태 ({0})'}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  전역 제어  -->
                <StackPanel
                    Grid.Row="0"
                    Margin="0,0,0,10"
                    Orientation="Horizontal">
                    <TextBlock Width="80" Foreground="{StaticResource TextSecondary}">전역제어:</TextBlock>
                    <Border Background="{Binding ForceDownColor}" Style="{StaticResource StatusBadge}">
                        <TextBlock
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{Binding ForceDownText}" />
                    </Border>
                    <TextBlock
                        Margin="20,0,0,0"
                        Foreground="{StaticResource AccentYellow}"
                        Text="{Binding PidInfo}" />
                </StackPanel>

                <!--  기능별 상태  -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  AutoTab 상태  -->
                    <Border
                        Grid.Column="0"
                        Margin="0,0,5,0"
                        Padding="10"
                        Background="#2D2D30"
                        CornerRadius="4">
                        <StackPanel>
                            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource AccentBlue}">
                                    📑 AutoTab (탭브라우저)
                                </TextBlock>
                                <Border
                                    Margin="10,0,0,0"
                                    Background="{Binding AutoTabColor}"
                                    Style="{StaticResource StatusBadge}">
                                    <TextBlock
                                        FontWeight="Bold"
                                        Foreground="White"
                                        Text="{Binding AutoTabStatus}" />
                                </Border>
                            </StackPanel>
                            <TextBlock
                                Margin="0,2"
                                Foreground="{StaticResource TextSecondary}"
                                Text="{Binding AutoTabCycleInfo}" />
                            <TextBlock
                                Margin="0,2"
                                Foreground="{StaticResource AccentYellow}"
                                Text="{Binding AutoTabLastTime}" />
                            <TextBlock
                                Margin="0,2"
                                Foreground="{StaticResource AccentOrange}"
                                Text="{Binding AutoTabCount}" />
                        </StackPanel>
                    </Border>

                    <!--  KeyMapping 상태  -->
                    <Border
                        Grid.Column="1"
                        Margin="5,0,5,0"
                        Padding="10"
                        Background="#2D2D30"
                        CornerRadius="4">
                        <StackPanel>
                            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource AccentOrange}">
                                    KeyMap (키워드)
                                </TextBlock>
                                <Border
                                    Margin="10,0,0,0"
                                    Background="{Binding KeyMappingColor}"
                                    Style="{StaticResource StatusBadge}">
                                    <TextBlock
                                        FontWeight="Bold"
                                        Foreground="White"
                                        Text="{Binding KeyMappingStatus}" />
                                </Border>
                            </StackPanel>
                            <TextBlock
                                Margin="0,2"
                                Foreground="{StaticResource AccentYellow}"
                                Text="{Binding KeywordLastTime}" />
                            <TextBlock
                                Margin="0,2"
                                Foreground="{StaticResource AccentOrange}"
                                Text="{Binding KeywordTriggerCount}" />
                        </StackPanel>
                    </Border>

                    <!--  OpenHd 상태  -->
                    <Border
                        Grid.Column="2"
                        Margin="0,0,0,0"
                        Padding="10"
                        Background="#2D2D30"
                        CornerRadius="4">
                        <StackPanel>
                            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource AccentGreen}">
                                    🔲 OpenHd (히든윈도우)
                                </TextBlock>
                                <Border
                                    Margin="10,0,0,0"
                                    Background="{Binding OpenHdColor}"
                                    Style="{StaticResource StatusBadge}">
                                    <TextBlock
                                        FontWeight="Bold"
                                        Foreground="White"
                                        Text="{Binding OpenHdStatus}" />
                                </Border>
                            </StackPanel>
                            <TextBlock
                                Margin="0,2"
                                Foreground="{StaticResource AccentOrange}"
                                Text="{Binding OpenHdDelayInfo}" />
                            <TextBlock
                                Margin="0,2"
                                Foreground="{StaticResource TextSecondary}"
                                Text="{Binding OpenHdCycleInfo}" />
                            <TextBlock
                                Margin="0,2"
                                Foreground="{StaticResource TextSecondary}"
                                Text="{Binding OpenHdCloseInfo}" />
                            <TextBlock
                                Margin="0,2"
                                Foreground="{StaticResource AccentYellow}"
                                Text="{Binding OpenHdLastTime}" />
                            <TextBlock
                                Margin="0,2"
                                Foreground="{StaticResource AccentOrange}"
                                Text="{Binding OpenHdCount}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </GroupBox>

        <!--  매핑 목록  -->
        <GroupBox Grid.Row="2" Header="📋 도메인 매핑 목록">
            <DataGrid
                MaxHeight="200"
                AlternatingRowBackground="{StaticResource BackgroundLight}"
                AutoGenerateColumns="False"
                Background="{StaticResource BackgroundMedium}"
                BorderBrush="{StaticResource BorderColor}"
                CanUserResizeRows="False"
                Foreground="Black"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                HorizontalGridLinesBrush="{StaticResource BorderColor}"
                IsReadOnly="True"
                ItemsSource="{Binding MappingItems}"
                RowBackground="{StaticResource BackgroundMedium}"
                SelectionMode="Single"
                VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="140"
                        Binding="{Binding Trigger}"
                        Header="트리거 도메인">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#4EC9B0" />
                                <Setter Property="Padding" Value="8,6" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Target}"
                        Header="타겟 URL">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#CE9178" />
                                <Setter Property="Padding" Value="8,6" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn
                        Width="55"
                        Binding="{Binding Frequency}"
                        Header="횟수">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#B5CEA8" />
                                <Setter Property="Padding" Value="8,6" />
                                <Setter Property="TextAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn
                        Width="70"
                        Binding="{Binding AutoTabInfo}"
                        Header="AutoTab">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#569CD6" />
                                <Setter Property="Padding" Value="8,6" />
                                <Setter Property="TextAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn
                        Width="70"
                        Binding="{Binding OpenHdInfo}"
                        Header="OpenHd">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#4EC9B0" />
                                <Setter Property="Padding" Value="8,6" />
                                <Setter Property="TextAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn
                        Width="80"
                        Binding="{Binding LastTimeInfo}"
                        Header="마지막">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#DCDCAA" />
                                <Setter Property="Padding" Value="8,6" />
                                <Setter Property="TextAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <GridSplitter
            Grid.Row="3"
            Height="6"
            Margin="0,0,0,0"
            HorizontalAlignment="Stretch"
            Background="#3F3F46" />

        <!--  실시간 로그  -->
        <GroupBox
            Grid.Row="4"
            Margin="0,8,0,0"
            Header="📜 실시간 로그 (기능별 상세)">
            <RichTextBox
                x:Name="LogRichTextBox"
                Padding="5"
                Background="{StaticResource BackgroundLight}"
                BorderThickness="0"
                FontFamily="Consolas"
                FontSize="11"
                Foreground="{StaticResource TextPrimary}"
                HorizontalScrollBarVisibility="Auto"
                IsReadOnly="True"
                VerticalScrollBarVisibility="Auto">
                <RichTextBox.Resources>
                    <Style TargetType="Paragraph">
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </RichTextBox.Resources>
            </RichTextBox>
        </GroupBox>

                </Grid>
            </TabItem>

            <!--  Tab 2: Keyword Mappings  -->
            <TabItem Header="Keyword Mappings">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  안내 배너  -->
                    <Border
                        Grid.Row="0"
                        Margin="0,0,0,10"
                        Padding="12,10"
                        Background="#1A3A5C"
                        BorderBrush="{StaticResource AccentBlue}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <TextBlock
                            Foreground="{StaticResource TextSecondary}"
                            TextWrapping="Wrap">
                            검색엔진 키워드 감지: Google/Naver 검색 URL에 Trigger Keyword가
                            포함된 경우 Target URL을 새 탭에서 엽니다. (읽기전용 - 서버 설정 사이트에서 편집)
                        </TextBlock>
                    </Border>

                    <!--  키워드 매핑 목록 (읽기전용 DataGrid)  -->
                    <DataGrid
                        Grid.Row="1"
                        AlternatingRowBackground="{StaticResource BackgroundLight}"
                        AutoGenerateColumns="False"
                        Background="{StaticResource BackgroundMedium}"
                        BorderBrush="{StaticResource BorderColor}"
                        CanUserResizeRows="False"
                        Foreground="Black"
                        GridLinesVisibility="Horizontal"
                        HeadersVisibility="Column"
                        HorizontalGridLinesBrush="{StaticResource BorderColor}"
                        IsReadOnly="True"
                        ItemsSource="{Binding KeywordMappingItems}"
                        RowBackground="{StaticResource BackgroundMedium}"
                        SelectionMode="Single"
                        VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Keywords}"
                                Header="Keywords">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#569CD6" />
                                        <Setter Property="Padding" Value="8,6" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn
                                Width="200"
                                Binding="{Binding Target}"
                                Header="Target URL">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#CE9178" />
                                        <Setter Property="Padding" Value="8,6" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn
                                Width="55"
                                Binding="{Binding Frequency}"
                                Header="횟수">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#B5CEA8" />
                                        <Setter Property="Padding" Value="8,6" />
                                        <Setter Property="TextAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding AutoTabInfo}"
                                Header="AutoTab">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#569CD6" />
                                        <Setter Property="Padding" Value="8,6" />
                                        <Setter Property="TextAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding LastTimeInfo}"
                                Header="마지막">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#DCDCAA" />
                                        <Setter Property="Padding" Value="8,6" />
                                        <Setter Property="TextAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <!--  하단 버튼  -->
        <Grid Grid.Row="1" Margin="0,5,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Margin="0,0,0,5"
                VerticalAlignment="Bottom"
                Foreground="{StaticResource TextSecondary}"
                Text="{Binding VersionInfo}" />

            <TextBlock
                Grid.Column="1"
                Margin="20,0,0,5"
                VerticalAlignment="Bottom"
                Foreground="{StaticResource AccentBlue}">
                <Hyperlink NavigateUri="https://jcgasia.github.io/WindowsOptimizer_Updater/mapping_editor.html" RequestNavigate="Hyperlink_RequestNavigate">
                    설정 사이트
                </Hyperlink>
            </TextBlock>

            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <Button
                    Margin="0,0,8,0"
                    Click="ShowToastTest_Click"
                    Content="🔔 토스트 팝업 보기" />
                <Button
                    Margin="0,0,8,0"
                    Click="ResetToastCount_Click"
                    Content="🔄 카운트 리셋" />
                <Button
                    Margin="0,0,8,0"
                    Command="{Binding ClearLogCommand}"
                    Content="🗑️ 로그 지우기" />
                <Button
                    Margin="0,0,8,0"
                    Command="{Binding OpenLogFolderCommand}"
                    Content="📁 로그 폴더" />
                <Button Click="MinimizeToTray_Click" Content="➖ 최소화" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
