<Window
    x:Class="WindowsOptimizer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:WindowsOptimizer.ViewModels"
    Title="Windows Optimizer - Debug Console"
    Width="900"
    Height="700"
    Closing="Window_Closing"
    WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  상태 패널  -->
        <GroupBox
            Grid.Row="0"
            Margin="0,0,0,10"
            Header="모니터링 상태">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    FontSize="14"
                    FontWeight="Bold">
                    <Run Text="상태: " />
                    <Run Foreground="{Binding StatusColor}" Text="{Binding StatusText}" />
                </TextBlock>
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    Text="{Binding CurrentUrl}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding CurrentUrl}" />

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Text="{Binding KeyMatchInfo}" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="1"
                    Text="{Binding UrlMatchInfo}" />

                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Text="{Binding TriggerInfo}" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="1"
                    Text="{Binding LastKeyword}" />

                <TextBlock
                    Grid.Row="3"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    FontSize="10"
                    Foreground="Gray"
                    Text="{Binding FrequencyStatus}"
                    TextWrapping="Wrap" />

                <StackPanel
                    Grid.Row="0"
                    Grid.RowSpan="4"
                    Grid.Column="2"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center">
                    <Button
                        Width="120"
                        Height="35"
                        Margin="0,5"
                        Command="{Binding ToggleMonitoringCommand}"
                        Content="{Binding MonitorButtonText}"
                        FontWeight="Bold" />
                    <Button
                        Width="120"
                        Height="28"
                        Margin="0,5"
                        Command="{Binding ReloadConfigCommand}"
                        Content="설정 새로고침" />
                    <Button
                        Width="120"
                        Height="28"
                        Margin="0,5"
                        Command="{Binding ToggleModeCommand}"
                        Content="모드 전환"
                        ToolTip="PlanB ↔ Weaping" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <!--  서버 설정 정보  -->
        <GroupBox
            Grid.Row="1"
            Margin="0,0,0,10"
            Header="서버 설정 (BegParser)">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock FontSize="11" Text="{Binding ConfigKeyMatch}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock FontSize="11" Text="{Binding ConfigUrlMatch}" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <!--  매핑 목록  -->
        <GroupBox
            Grid.Row="2"
            MaxHeight="150"
            Margin="0,0,0,10"
            Header="매핑 목록">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <GroupBox
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="0,0,5,0"
                    Header="KeyMatch Sites">
                    <ListBox
                        MaxHeight="100"
                        FontSize="10"
                        ItemsSource="{Binding MatchSites}" />
                </GroupBox>

                <!--<GroupBox Header="UrlMatch Patterns" Grid.Column="1" Margin="5,0,0,0">
                    <ListBox ItemsSource="{Binding UrlPatterns}" MaxHeight="100" FontSize="10"/>
                </GroupBox>-->
            </Grid>
        </GroupBox>

        <!--  로그 뷰어  -->
        <GroupBox Grid.Row="3" Header="실시간 로그">
            <TextBox
                FontFamily="Consolas"
                FontSize="11"
                HorizontalScrollBarVisibility="Auto"
                IsReadOnly="True"
                Text="{Binding LogText, Mode=OneWay}"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto" />
        </GroupBox>

        <!--  하단 버튼  -->
        <StackPanel
            Grid.Row="4"
            Margin="0,10,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <TextBlock
                Margin="0,0,20,0"
                VerticalAlignment="Center"
                Foreground="Gray"
                Text="{Binding VersionInfo}" />
            <Button
                Width="80"
                Margin="5,0"
                Command="{Binding ClearLogCommand}"
                Content="로그 지우기" />
            <Button
                Width="80"
                Margin="5,0"
                Command="{Binding OpenLogFolderCommand}"
                Content="로그 폴더" />
            <Button
                Width="60"
                Margin="5,0"
                Click="MinimizeToTray_Click"
                Content="최소화" />
        </StackPanel>
    </Grid>
</Window>
